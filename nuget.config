<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Pathoschild" value="https://nuget.pkg.github.com/Pathoschild/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <Pathoschild>
      <add key="Username" value="Pathoschild" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </Pathoschild>
  </packageSourceCredentials>
</configuration>
